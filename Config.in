# Kconfig entry point for the RelicOS external tree.
# external.mk globs package/*/*.mk on its own; the Config.in files must be
# sourced here by hand, one per package.
source "$BR2_EXTERNAL_RELICOS_PATH/package/sdl2-diag/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/freeimage/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/emulationstation/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/es-theme-carbon/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/relicos-joypad/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/retroarch/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-gambatte/Config.in"
