# Kconfig entry point for the RelicOS external tree.
# external.mk globs package/*/*.mk on its own; the Config.in files must be
# sourced here by hand, one per package.
source "$BR2_EXTERNAL_RELICOS_PATH/package/sdl2-diag/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/freeimage/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/emulationstation/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/es-theme-relicos/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/relicos-joypad/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/retroarch/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-gambatte/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-beetle-ngp/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-beetle-pce-fast/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-beetle-vb/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-beetle-wswan/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-fceumm/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-genesisplusgx/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-mgba/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-picodrive/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-snes9x2010/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-stella/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/libretro-vecx/Config.in"
source "$BR2_EXTERNAL_RELICOS_PATH/package/fatresize/Config.in"
