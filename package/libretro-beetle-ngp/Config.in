config BR2_PACKAGE_LIBRETRO_BEETLE_NGP
	bool "libretro-beetle-ngp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_RETROARCH
	help
	  Beetle NeoPop, the libretro Neo Geo Pocket / Pocket Color
	  core (M20). No BIOS. One RelicOS system, `ngp`, covers both
	  machines. Installed as
	  /usr/lib/libretro/mednafen_ngp_libretro.so.
