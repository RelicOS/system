+#ifdef RELICOS
+void GuiControllersSettings::openControllerPage(Window* window, const std::string& name, const std::string& guid, bool internal)
+{
+	auto s = new GuiSettings(window, name);
+	std::string prefix = "controllers." + guid + ".";
+	SystemConf* conf = SystemConf::getInstance();
+
+	s->addGroup(_("BUTTONS"));
+	if (!internal)
+	{
+		auto labels = std::make_shared<SwitchComponent>(window);
+		labels->setState(conf->getBool(prefix + "labels"));
+		s->addWithDescription(_("BUTTONS BY LABEL"), _("Off: by position, as on a SNES pad -- the bottom button is B, the right one A. On: the button printed A is A."), labels);
+		s->addSaveFunc([conf, prefix, labels] { conf->setBool(prefix + "labels", labels->getState()); });
+	}
+	auto swapAB = std::make_shared<SwitchComponent>(window);
+	swapAB->setState(conf->getBool(prefix + "swap_ab"));
+	s->addWithDescription(_("SWAP A AND B"), _("In the menu and in the games."), swapAB);
+	s->addSaveFunc([conf, prefix, swapAB] { conf->setBool(prefix + "swap_ab", swapAB->getState()); });
+	auto swapXY = std::make_shared<SwitchComponent>(window);
+	swapXY->setState(conf->getBool(prefix + "swap_xy"));
+	s->addWithDescription(_("SWAP X AND Y"), _("In the menu and in the games."), swapXY);
+	s->addSaveFunc([conf, prefix, swapXY] { conf->setBool(prefix + "swap_xy", swapXY->getState()); });
+
+	s->addGroup(_("PLAYERS"));
+	auto preferred = std::make_shared<SwitchComponent>(window);
+	preferred->setState(conf->get("controllers.player1.guid") == guid);
+	s->addWithDescription(_("PREFERRED PLAYER 1"), _("Player 1 whenever it is connected and PLAYER ASSIGNMENTS are on DEFAULT. One controller at a time; with none, the handheld is player 1."), preferred);
+	s->addSaveFunc([conf, guid, preferred]
+	{
+		bool isPreferred = conf->get("controllers.player1.guid") == guid;
+		if (preferred->getState() && !isPreferred)
+			conf->set("controllers.player1.guid", guid);
+		else if (!preferred->getState() && isPreferred)
+			conf->set("controllers.player1.guid", "");
+	});
+
+	s->addSaveFunc([conf] { conf->saveSystemConf(); });
+	window->pushGui(s);
+}
+#endif
+
