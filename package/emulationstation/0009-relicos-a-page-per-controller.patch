 		mNameMap.erase(it);
 }
 
+#ifdef RELICOS
+// The pad's own settings (CONTROLLER SETTINGS -> the pad -> ..., kept in
+// relicos.conf under controllers.<guid>.*), applied here so that the map
+// on disk (es_input.cfg, by LABEL: "a" is the button printed A) is never
+// rewritten and the menu and the games read the same choices:
+//   labels   external pad only. Off (default): by position -- the ES's
+//            "a"/"b"/"x"/"y" mean east/south/north/west as on a SNES pad,
+//            so on an Xbox-layout pad the button printed B is "a". On:
+//            the printed letter is the name. The handheld's own labels
+//            are its positions, nothing to choose.
+//   swap_ab  a<->b on top of the above, for the player who wants it.
+//   swap_xy  x<->y likewise.
+// relicos-pads reads the same keys for RetroArch.
+static std::string swapPair(const std::string& n, const char* p, const char* q)
+{
+	return n == p ? q : n == q ? p : n;
+}
+
+std::string InputConfig::relicosName(const std::string& name) const
+{
+	if (mDeviceId < 0 || (name != "a" && name != "b" && name != "x" && name != "y"))
+		return name;
+	SystemConf* conf = SystemConf::getInstance();
+	std::string prefix = "controllers." + mDeviceGUID + ".";
+	std::string n = name;
+	if (!mIsInternal && !conf->getBool(prefix + "labels"))
+	{
+		n = swapPair(n, "a", "b");
+		n = swapPair(n, "x", "y");
+	}
+	if (conf->getBool(prefix + "swap_ab"))
+		n = swapPair(n, "a", "b");
+	if (conf->getBool(prefix + "swap_xy"))
+		n = swapPair(n, "x", "y");
+	return n;
+}
+#endif
+
 bool InputConfig::getInputByName(const std::string& name, Input* result)
 {
+#ifdef RELICOS
+	auto it = mNameMap.find(relicosName(toLower(name)));
+#else
 	auto it = mNameMap.find(toLower(name));
+#endif
 	if(it != mNameMap.cend())
 	{
 		*result = it->second;
@@ -265,10 +308,17 @@
 
 		if (chk.device == input.device && chk.type == input.type && chk.id == input.id)
 		{
+#ifdef RELICOS
+			// The swaps are their own inverse: the stored name maps back
+			// to the name a caller would ask getInputByName for.
+			std::string mapped = relicosName(iterator->first);
+#else
+			std::string mapped = iterator->first;
+#endif
 			if (chk.type == TYPE_HAT)
 			{
 				if (input.value == 0 || input.value & chk.value)
-					maps.push_back(iterator->first);
+					maps.push_back(mapped);
 
 				continue;
 			}
@@ -276,10 +326,10 @@
 			if (input.type == TYPE_AXIS)
 			{
 				if (input.value == 0 || chk.value == input.value)
-					maps.push_back(iterator->first);
+					maps.push_back(mapped);
 			}
 			else
-				maps.push_back(iterator->first);
+				maps.push_back(mapped);
