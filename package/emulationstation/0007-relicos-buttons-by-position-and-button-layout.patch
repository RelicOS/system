 	bool isMappedTo(const std::string& name, Input input, bool reversedAxis = false); 
diff -ruN a/es-core/src/InputManager.cpp b/es-core/src/InputManager.cpp
--- a/es-core/src/InputManager.cpp	2026-09-14 17:16:46.862421748 -0300
+++ b/es-core/src/InputManager.cpp	2026-09-14 17:17:16.771468113 -0300
@@ -356,6 +356,13 @@
 #endif
 
 	SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, Settings::getInstance()->getBool("BackgroundJoystickInput") ? "1" : "0");
+#ifdef RELICOS
+	// Positions, not labels: SDL maps a Nintendo-brand pad by the letters
+	// printed on it unless told otherwise, and RelicOS keeps every pad's
+	// map by position (a = south, b = east...) with the pad's BUTTON
+	// LAYOUT deciding which position confirms.
+	SDL_SetHint(SDL_HINT_GAMECONTROLLER_USE_BUTTON_LABELS, "0");
+#endif
 	SDL_InitSubSystem(SDL_INIT_JOYSTICK);
 
 	mJoysticksLock.lock();
@@ -779,8 +786,16 @@
    { "lefttrigger",   "l2" },
    { "righttrigger",  "r2" },
    { "leftstick",     "l3" },
-   { "rightstick",    "r3" }
+   { "rightstick",    "r3" },
+#ifdef RELICOS
+   // The dedicated hotkey of a pad that has one (Xbox/PS/Home button):
+   // the launcher makes it RetroArch's menu toggle, the FN of that pad.
+   // Without it "hotkey" falls back to select below, and a select that is
+   // also the menu toggle is useless as either.
+   { "guide",         "hotkey" }
+#else
    // { "guide",         "hotkey" } // Better take select for hotkey ?
+#endif
 };
 
 bool InputManager::loadFromSdlMapping(InputConfig* config, const std::string& mapping)
@@ -803,6 +818,21 @@
