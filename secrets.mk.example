# Copy to secrets.mk (gitignored) and fill in. Read by external.mk at build
# time; nothing here is ever committed or put on the image as a file --
# the values are compiled into the ES binary.
#
# ScreenScraper developer credentials (https://www.screenscraper.fr, a
# developer account for the software "RelicOS"): the scraper sends them
# with every API request. Without them the API refuses and the ES reports
# "zero results" (M22, build 11). After editing:
#   make -C output emulationstation-reconfigure
RELICOS_SCREENSCRAPER_DEV_LOGIN = devid=XXXX&devpassword=YYYY&softname=relicos
