# RelicOS on the R36S: mainline boot chain, mainline kernel, BusyBox userspace.
# The artifact is sdcard.img with the boot chain (TPL + SPL + BL31 + U-Boot
# proper) and, since M12, the definitive GPT map: boot A/B (FAT), rootfs A/B
# (erofs, read-only by format), a private ext4 "data" partition for system
# state, and the FAT32 "RELICOS" partition the user writes from any PC.

# --- Target: RK3326 is a quad-core Cortex-A35 (ARMv8-A, 64-bit) --------------
BR2_aarch64=y
BR2_cortex_a35=y

# --- Patches: applied from this tree after each package's source extract ----
# patches/<pkg>/*.patch, in lexical order. Buildroot does NOT notice new or
# edited patches on its own: run `make -C output <pkg>-dirclean` first.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RELICOS_PATH)/patches"

# --- Toolchain: built from source, glibc -------------------------------------
# glibc is what the ecosystem recipes around this hardware are tested against.
# Kernel headers pinned to 6.12 now so the toolchain does not have to be
# rebuilt when the kernel arrives in a later milestone.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_12=y
# C++ arrived with Mesa (M9): mesa3d depends on BR2_INSTALL_LIBSTDCPP, which
# only this symbol selects. Flipping it invalidates the whole toolchain --
# the M9 build was a full `rm -rf output` rebuild, deliberately.
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- Kernel: mainline 6.12 LTS ----------------------------------------------
# Same version as the pinned headers (BR2_KERNEL_HEADERS_6_12 == 6.12.91), so
# adding the kernel does not rebuild the toolchain.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.91"
# Upstream's own arm64 defconfig: the configuration mainline tests. It already
# carries ARCH_ROCKCHIP, dw_mmc-rockchip, 8250_dw and rk817. Trimming it is a
# later milestone, with measurements.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
# Raw Image: what booti takes directly, no decompressor in the middle.
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Our own DTS lives here. Buildroot rsyncs this directory into the kernel's
# arch/arm64/boot/dts/, keeping subdirectories -- which is why the file sits
# under dts/rockchip/: it must land next to rk3326-odroid-go.dtsi for the
# include to resolve. The .dtb is installed flat into output/images/.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/dts"
# Merged on top of the arch defconfig above. Buildroot does NOT reconfigure the
# kernel when this file changes: run `make -C output linux-dirclean` first.
# This is the first change in the project that alters the kernel Image, so the
# M4/M5 "Image is byte-identical" invariant ends here, deliberately, and the
# new hash becomes the baseline.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/linux.fragment"

# --- Root filesystem: erofs, immutable by format (M12) -----------------------
# The ADR 0009 ext4-rw rootfs ends here: erofs has no write path in the
# format at all, so the system partition's immutability is a property, not a
# mount option someone can flip back. ADR 0003 picked erofs over squashfs
# for faster random reads on a weak CPU reading from an SD card. The kernel
# mounts it directly (no initramfs); see board/r36s/boot.cmd for how it is
# named on the kernel command line (PARTUUID of GPT slot A). lz4hc level 9
# is Buildroot's default: expensive once at image time on the PC, cheap on
# every read on the device. dedupe/fragments/ztailpacking/pcluster stay off
# on this first pass -- each is one line and one measurable number, seeds
# for after this baseline exists.
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC_LEVEL=9
# BR2_TARGET_ROOTFS_TAR is not set
# Until M11 BR2_TARGET_ROOTFS_EXT2 pulled this in as a side effect; the
# genimage step still needs mke2fs to build the empty data.ext4 (the
# journaled system-state partition). Without this line the build breaks in
# genimage, not in Buildroot.
BR2_PACKAGE_HOST_E2FSPROGS=y
# The inittab's "mount -o remount,rw /" would fail on every boot now --
# there is nothing to remount to. system.mk comments the line out when this
# is off. Not cosmetic: with erofs the remount is an error, not a no-op.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# --- GPU userspace (M9): Mesa with the Gallium panfrost driver + kmscube -----
# The other half of ADR 0002 ("mainline + Panfrost"): the kernel driver is in
# board/r36s/linux.fragment; this is the userspace that speaks to it.
# Scope is the minimum that proves the thesis: GLES + EGL + GBM for a KMS/DRM
# render with no display server -- no GLX/X11, no Vulkan, no Wayland. GBM,
# libdrm, expat and zlib arrive via select.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/busybox.fragment"
BR2_PACKAGE_MESA3D=y
# Ballast, accepted deliberately (M9 decision): in this Buildroot the panfrost
# driver `depends on` target LLVM and `select`s the precomp shader compiler,
# which in turn selects OpenCL => clang + libclc on the target. The precomp
# compiler (mesa_clc) only ever runs on the build host; none of this is used
# at runtime on the device. Decoupling it is a trim-milestone seed, not a
# bring-up fight.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# The canonical "GPU first light" test: a spinning cube on KMS/GBM/EGL,
# GLES2, FPS on stdout. Takes DRM master, so the fb console leaves the
# screen while it runs -- expected, not a bug.
BR2_PACKAGE_KMSCUBE=y

# --- SDL2 over KMS/DRM (M10) -------------------------------------------------
# The library layer between the EmulationStation and the M9 stack. KMSDRM is
# the only video driver compiled in (no X11/Wayland/fbdev), so SDL cannot pick
# a wrong one. Its GBM/EGL/GLES providers are mesa3d since M9; libdrm comes
# via select. With eudev below, sdl2.mk configures --enable-libudev and SDL
# enumerates joysticks through udev's classification.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_KMSDRM=y

# --- /dev management: eudev (M10, device-measured decision) ------------------
# The M5 "devtmpfs only, no hotplug agent" property ends here, deliberately.
# The first M10 card measured why: SDL2's udev-less fallback classifier only
# marks a device as a joystick when it has ABS_X+ABS_Y axes, so this unit's
# gpio-keys (17 buttons, BTN_GAMEPAD/BTN_DPAD_* codes, zero axes) was
# invisible to SDL -- sdl2-diag printed "joysticks: 1" (only adc-joystick)
# and the ES never saw a button. udev's own input_id classifies button-only
# gamepads as joysticks ("Others have buttons only but no axes" -- their
# comment); eudev is the ecosystem path (Batocera/KNULLI run it on this same
# hardware class). Chosen over patching SDL's fallback (Tiago, 2026-08-31).
# Module loading was off from M10 to M22 part 1 (the card shipped no
# /lib/modules); it is on since M22 part 2, when the radio's drivers became
# modules: udev's coldplug loads them from each device's MODALIAS through
# libkmod (kmod comes via select), and any future dongle gets the same
# treatment -- that is what "peripheral is =m" needs to actually run. The
# hwdb stays off (input_id needs no hwdb, and it would cost a host-eudev
# build plus a binary blob in the rootfs).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV_MODULE_LOADING=y
# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set

# --- EmulationStation dependencies (M10) -------------------------------------
# alsa-lib flips sdl2's --enable-alsa on automatically (sdl2.mk) and satisfies
# the ES's find_package(ALSA REQUIRED). No sound card is configured yet: mixer
# errors in the ES log are expected, not fatal -- real audio is its own
# milestone.
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_RAPIDJSON=y
# vlc is the ES's hard video-preview dependency (find_package(VLC REQUIRED),
# no off switch). Buildroot's vlc selects nothing scary here (qt/xcb only
# activate if those packages exist -- they don't), but ffmpeg is NOT pulled
# in by it: avcodec/swscale must be explicit or vlc builds without any real
# codec. Accepted ballast (M10 decision, same shape as M9's LLVM); trimming
# is a seed.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_VLC=y

# --- The menu itself (M10): our first custom packages ------------------------
# batocera-emulationstation (KNULLI fork, pinned commit) built standalone,
# the RelicOS theme (es-theme-relicos; carbon served M10-M15), freeimage (the one dependency
# Buildroot upstream lacks, transplanted from batocera.linux -- renamed from
# their "libfreeimage": that exact name is a Buildroot legacy tombstone that
# selects BR2_LEGACY and stops the build), and the SDL diagnostic rung.
# Recipes live in package/ of this external tree.
BR2_PACKAGE_SDL2_DIAG=y
BR2_PACKAGE_FREEIMAGE=y
BR2_PACKAGE_EMULATIONSTATION=y
BR2_PACKAGE_ES_THEME_RELICOS=y

# --- Rootfs overlay (M10, reshaped in M12): the ES's runtime wiring ----------
# M10 brought es_systems.cfg (one dummy system -- the ES discards systems
# with zero games and errors out with none left) and the pre-seeded
# es_input.cfg; M11 the autostart wrapper (usr/bin/relicos-menu, launched
# from the inittab -- see post-build.sh) and usr/sbin/shutdown, mapping the
# ES's `shutdown -Ph/-r now` onto BusyBox poweroff/reboot. M12 moved the ES
# seeds into usr/share/relicos/data/ (the first-boot skeleton S00storage
# copies into /data, never overwriting), added etc/init.d/S00storage (mount
# data+relicos, seed), etc/default/seedrng (seed dir on /data), and the two
# "where things are" files next to the ES binary on the immutable side:
# usr/bin/emulationstation.ini (path map) and usr/bin/resources (symlink).
# The dummy "game" file moved to the RELICOS partition (board/r36s/relicos/).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/rootfs-overlay"

# --- Audio userspace (M13) ---------------------------------------------------
# alsa-lib has been aboard since M10 (ES dependency); these are the audio
# bench tools -- the sdl2-diag of sound. amixer reads/writes the card's
# controls (Master, Playback Mux), aplay plays a wav, speaker-test makes a
# tone from nothing. Permanent residents: the investigation tools for any
# future audio regression. The two package defaults are switched off on
# purpose: alsactl (no persistent ALSA state by design -- defaults come
# from S30audio, the user's volume from the ES's es_settings.cfg on /data)
# and alsamixer (an ncurses UI nothing here needs).
BR2_PACKAGE_ALSA_UTILS=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# No jack daemon: this unit's jack switches mechanically and has no working
# detect line (see the DTS, "The sound"). The audible proof of the stack
# on the device was ES background music from two bench WAVs dropped in
# the music path (usr/bin/emulationstation.ini); the product ships no
# music, so nothing of that is in the image. Note for later: this
# SDL_mixer decodes WAV only (no vorbis/mp3/flac packages).

# --- The emulator (M14): RetroArch + the first core + the input fuser ------
# RetroArch (package/retroarch, transplanted from batocera.linux) loads a
# libretro core and drives video (KMS/GBM + EGL on the M9 stack, no display
# server), audio (ALSA -> the M13 dmix) and input (udev). RGUI menu only, no
# assets, no networking. gambatte is the first core (GB/GBC: small, no
# dynarec, the theme has its logo); one core is the observation, the list is
# product. relicos-joypad fuses this unit's two evdev devices (gpio-keys +
# adc-joystick) into one uinput gamepad, because RetroArch binds one device
# per port -- it needs CONFIG_INPUT_UINPUT (board/r36s/linux.fragment). The
# ES launches through usr/bin/relicos-launch (overlay), which hands
# RetroArch the user's config on /data plus the product defaults on the
# rootfs (usr/share/relicos/retroarch/relicos.cfg).
BR2_PACKAGE_RELICOS_JOYPAD=y
BR2_PACKAGE_RETROARCH=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y

# --- The shelf: fifteen consoles, one core each (M20) --------------------------
# One core per console is the product decision (M20): the reference distros
# offer several because they serve many boards and let the user switch; this
# image serves one device and has no core downloader, so a second core for a
# system would be permanent weight, one more options file, and a question the
# player should not be asked. The ES of this lineage already reads
# <emulators><core command=...>, so adding one later costs nothing today.
#
# Chosen for a quad Cortex-A35 with no BIOS to ship: nothing here needs a file
# the project cannot verify. genesisplusgx alone serves FOUR systems
# (megadrive, mastersystem, gamegear, sg1000). Ten of the eleven build with
# their own Makefile in the M14 gambatte mould; mgba is CMake and picodrive
# comes from git with submodules. Arcade, PSX, the BIOS consoles and the
# marginal ones (N64, Dreamcast, PSP, NDS) are named seeds, not omissions.
BR2_PACKAGE_LIBRETRO_BEETLE_NGP=y
BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST=y
BR2_PACKAGE_LIBRETRO_BEETLE_VB=y
BR2_PACKAGE_LIBRETRO_BEETLE_WSWAN=y
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_GENESISPLUSGX=y
BR2_PACKAGE_LIBRETRO_MGBA=y
BR2_PACKAGE_LIBRETRO_PICODRIVE=y
BR2_PACKAGE_LIBRETRO_SNES9X2010=y
BR2_PACKAGE_LIBRETRO_STELLA=y
BR2_PACKAGE_LIBRETRO_VECX=y

# --- The user partition grows to the card (M19) -------------------------------
# The image carries a 1024 MiB RELICOS (FAT32, partition 6, the last one)
# so that any 4 GB card fits; on the first boot S00storage grows it to the
# end of whatever card the image was written to, in place, keeping what a
# PC may already have copied there. Three tools, once: parted --fix (moves
# the GPT backup table to the end of the card; libparted comes with it),
# fatresize (grows FAT32 and partition together -- package/fatresize in
# this tree, Buildroot has none) and fatlabel (the resizer drops the FAT
# label). parted selects util-linux's libuuid: util-linux is already built
# for libblkid, so this needs `make -C output util-linux-dirclean` once --
# Buildroot does not rebuild a package for a config change. ~0.7 MB before
# the erofs compression. fsck.fat and mkfs.fat stay off: neither is run
# by anything yet (fsck at boot is a named seed since M12).
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_FATRESIZE=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y

# --- The update (M25): the Linux side of the U-Boot environment ----------------
# fw_printenv/fw_setenv (libubootenv, the maintained implementation RAUC
# uses): the system reads and writes the same two environment copies U-Boot
# does, at the offsets /etc/fw_env.config -> /run/fw_env.config names
# (S00storage writes that file from the disk under the root). S98bootok
# marks the running slot good with it; the updater switches BOOT_ORDER with
# it. libyaml and zlib come along (~0.3 MB).
BR2_PACKAGE_LIBUBOOTENV=y
# RAUC, the updater (ADR 0004): opens a signed bundle from RELICOS/update/,
# verifies it (dm-verity + X.509 against /etc/rauc/keyring.pem), writes each
# image raw into the inactive slot (/dev/relicos/*, see /etc/rauc/system.conf)
# and hands the U-Boot environment "next boot from the other slot, three
# tries". glib2 and openssl are already here (bluez, libcurl). No D-Bus
# service: `rauc install` runs as a plain command (relicos-update calls it),
# no daemon. No network yet: the Wi-Fi milestone fetches the file with curl
# into the same folder and installs it the same way. host-rauc builds the
# bundle on the PC (board/r36s/make-bundle.sh, from post-image.sh) and
# brings host-squashfs for mksquashfs. rauc selects LIBOPENSSL_ENGINES (its
# signature code uses the ENGINE_* API): openssl, built without engines
# since M16, needs `make -C output libopenssl-dirclean` once -- Buildroot
# does not rebuild a package for a config change (build 2 of M25 failed on
# exactly this: implicit declaration of ENGINE_load_builtin_engines).
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_HOST_RAUC=y

# --- The ports (M26): what PortMaster asks of the system ----------------------
# PortMaster (portmaster.games) lives entirely on the user's partition,
# /relicos/roms/ports/PortMaster, reached through the /roms symlink in the
# overlay, and updates itself there; the image ships none of it (Tiago,
# 2026-09-20: the user downloads the version they want, as on ArkOS). What
# it asks of the system, read from its own files (PortMaster.sh, control.txt,
# pugwash, pySDL2gui.py, readelf of the binaries it bundles):
#   bash      every script it has and every port is #!/bin/bash;
#   python3   pugwash is #!/usr/bin/env python3 and brings its own libraries
#             (pysdl2, requests, loguru); from the interpreter it needs
#             ctypes (libffi, selected), zipfile (zlib), HTTPS to fetch ports
#             (ssl over the M22 OpenSSL) and xml.etree for the gamelist
#             (pyexpat). .pyc only, the default: the stdlib is compiled, its
#             own libraries are .py on the card;
#   SDL2_ttf, SDL2_image   the interface's text (TTF_SizeText) and its PNG
#             images (sdl2.ext.image.load_img); SDL2 and SDL2_mixer are here
#             since M10. libpng because sdl2_image only enables PNG when it
#             exists; JPEG waits for an image that needs it;
#   unzip     Info-ZIP's, over the BusyBox applet: PortMaster.sh reads the
#             archive comment (`unzip -z`) to check the architecture of a
#             runtimes zip dropped in autoinstall/, BusyBox has no -z, and
#             the empty answer makes the script delete the user's file.
# gptokeyb, sdl_resolution and the rest of what it bundles link only against
# libSDL2/libstdc++ (readelf); uinput is =y since M14, squashfs and loop for
# the runtimes are in the kernel since M25 (RAUC). Who this system is, for
# PortMaster's device detection, is /etc/os-release -- post-build.sh.
# bash and unzip are hidden behind this switch: Buildroot keeps every package
# that duplicates a BusyBox applet out of the menu unless it is on (build 1
# of M26 built python3 and the SDL libs and silently skipped both -- the
# defconfig line was there, the dependency was not). It only reveals the
# options; nothing else changes.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
# lzma (M26 build 2, measured): pugwash unpacks its own font, pylibs/
# resources/NotoSans.tar.xz, with Python's tarfile the first time it runs
# -- "lzma module is not available" was the Traceback of build 1b, before
# any window. (funcs.txt tries BusyBox tar first, which has no seamless xz
# here -- "invalid tar magic" -- and pugwash does it itself.)
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_LIBPNG=y
# JPEG (M26 build 5, measured): the image that asked for it is PortMaster's
# own default theme, no-image.jpg -- "Unsupported image format" from
# SDL_image with the window already open (build 4). PNG and JPEG are the
# two formats PortMaster accepts for a port's images (harbour.py); no
# other format is in its package. sdl2_image only enables JPEG when the
# library is here, and only at its configure step: sdl2_image-dirclean.
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_UNZIP=y
# OpenAL (M26 build 2, measured): PortMaster's LOVE runtime -- the splash
# of PortMaster itself and every LOVE port -- links libopenal.so.1 and does
# not bundle it: "error while loading shared libraries: libopenal.so.1" in
# build 1b's log. The distros PortMaster targets all ship it.
BR2_PACKAGE_OPENAL=y
# The rest of what that runtime asks of the system (M26 build 3, readelf of
# love.aarch64 and its libs.aarch64 in PortMaster.zip 2026.09.13, against
# the target): it bundles liblove, luajit, libmodplug and libogg, and
# expects libvorbisfile (build 2b's log: "libvorbisfile.so.3: cannot open
# shared object file"), libtheoradec and libmpg123 -- plus freetype, SDL2,
# zlib and OpenAL, already here. libvorbis selects libogg.
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_MPG123=y

# --- The radio (M22): Wi-Fi and Bluetooth bench tools --------------------------
# The kernel side (USB host controllers in the DTS, cfg80211, the rtl8733bu
# driver as a kernel extension, Bluetooth + btrtl) is in
# board/r36s/linux.fragment and linux/linux-ext-rtl8733bu.mk. `iw` is the
# cfg80211 shell: `iw dev` proves the driver registered a wireless device,
# `iw dev wlan0 scan` proves the radio hears the room -- the sdl2-diag of
# the Wi-Fi, run from /relicos/diag/run.sh since there is no serial this
# milestone. libnl comes via select. No wpa_supplicant, no DHCP client, no
# BlueZ yet: associating and pairing are the next rungs, each its own
# observation; the first is "the module enumerates and the driver binds".
BR2_PACKAGE_IW=y
# The driver goes INTO the kernel tree through a kernel extension
# (linux/linux-ext-rtl8733bu.mk) and comes out as 8733bu.ko; the package it
# selects is the download plus the Bluetooth firmware files in
# /lib/firmware. Changing either means `make -C output linux-dirclean`.
BR2_LINUX_KERNEL_EXT_RTL8733BU=y
# The menus (M22 part 3). Under the ES's NETWORK SETTINGS: wpa_supplicant
# (nl80211 is the default; the control socket and wpa_cli are what
# relicos-wifi talks to; WPA2-PSK and, with OpenSSL aboard for the TLS
# below, WPA3/SAE) and BusyBox's udhcpc, already aboard. Under
# CONTROLLER SETTINGS > BLUETOOTH: BlueZ's bluetoothd and bluetoothctl
# (the client is what relicos-bluetooth drives), which bring dbus and
# glib -- the cost of the commit, ~3 MiB, accepted. The ES side is patch
# 0005 in package/emulationstation (-DRELICOS). Nothing here is on the
# boot path unless the user switches it on in the menu (S40wifi,
# S45bluetooth read relicos.conf).
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
# TLS (M22 part 3, first thing the network was used for). The ES's scraper
# talks to screenscraper.fr over HTTPS and libcurl had been built with no
# TLS backend since M10 (there was no network to speak of): the scrape
# "succeeded" with nothing downloaded -- every request failed quietly.
# OpenSSL rather than mbedTLS because two things want it now (libcurl,
# and WPA3 in wpa_supplicant), and ca-certificates so a certificate can
# be checked at all (libcurl is built with the bundle at
# /etc/ssl/certs/ca-certificates.crt). ~3 MiB of rootfs, accepted.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# The input profiles: HID (classic pads and most keyboards) and HOG, HID
# over GATT (the Xbox Series and other BLE pads, handed to the kernel
# through uhid). Both off by default in Buildroot, and without them
# bluetoothd has no profile to offer a controller -- the first Xbox pad
# paired to nothing (build 9).
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
# btmon (M22 bench): the HCI trace, written by S45bluetooth to /tmp and
# copied to RELICOS/diag/hci.snoop at shutdown -- the one instrument that
# shows why a pad's pairing completes and its services never resolve
# (build 15). Decoded on the host with `btmon -r`. Bench, to be dropped
# when the radio's part of the milestone closes.
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y

# --- First-boot entropy (M11): haveged ---------------------------------------
# On a freshly flashed card nothing has seeded the kernel's crng yet, and
# S10udevd blocks the whole rcS on getrandom() until `crng init done` -- M10
# measured 7.7 s of that on the first boot (after one clean shutdown the
# S01seedrng seed kills it). haveged feeds the crng from CPU timing jitter,
# userspace only, no kernel change. Buildroot installs its init script as S21,
# after udevd where it is useless for this; post-build.sh renames it to S09.
BR2_PACKAGE_HAVEGED=y

# --- Post-build: only our kernel modules ---------------------------------------
# The arm64 defconfig builds ~1300 modules (71 MiB installed); every driver on
# the boot path is built in and, since M22 part 2, the peripheral ones (the
# radio) are modules the script keeps, with their dependency closure, and
# the rest goes. See the script for the full reasoning.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/post-build.sh"

# --- Identity on the serial console ------------------------------------------
# The login banner is the cheap, observable proof that the root filesystem the
# kernel mounted is the one we built -- the same trick as the DTB's "model".
BR2_TARGET_GENERIC_HOSTNAME="relicos"
BR2_TARGET_GENERIC_ISSUE="RelicOS"

# --- Time zone (M16, the clock commit) ---------------------------------------
# The RTC and the kernel keep UTC; this is what turns it into a wall clock.
# tzdata's "default" zone list (all continents, ~1 MiB installed) is what
# the ES offers in its TIME ZONE menu -- one zone only would leave that menu
# with one entry. Buildroot installs /etc/localtime as a symlink to this
# zone; post-build re-points it at /data/system/localtime, the writable
# copy of the same choice that the menu (via knulli-timezone) changes, and
# the /data seed carries the same default. Tiago's zone, Brazil's largest.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="America/Sao_Paulo"

# --- TF-A: BL31, the EL3 secure-world firmware -------------------------------
# Mainline U-Boot does not boot on 64-bit Rockchip without BL31 (it provides
# PSCI: CPU power on/off, suspend). "px30" is the SoC family; RK3326 is a
# variant of it. No BL32/OP-TEE: we keep the full 1 GiB of RAM.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="px30"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
# px30 produces bl31.elf only; the default here is "*.bin", which makes the
# install-to-images step fail with "cannot stat ... *.bin".
BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES="bl31/bl31.elf"

# --- U-Boot mainline ---------------------------------------------------------
# odroid-go2 is the closest mainline board (same SoC, same board family).
# Its SARADC board-detect table does not know this device's value (166), so
# the expected outcome is the full chain talking and stopping at
# "Unable to detect device type: -19" — that is M1 success, not failure.
# binman packs TPL+SPL+BL31+proper into the single u-boot-rockchip.bin.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_LATEST_VERSION=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="odroid-go2"
BR2_TARGET_UBOOT_NEEDS_DTC=y
# U-Boot's host tools (mkimage FIT support) include openssl headers, and
# mkeficapsule (built by default) needs gnutls and util-linux's libuuid.
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_UTIL_LINUX=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31_ELF=y
BR2_TARGET_UBOOT_USE_BINMAN=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip.bin"
# Fragment merged over the defconfig: re-enable the legacy image format (so
# "source" accepts mkimage -T script) and set our own bootcmd instead of
# bootstd's "bootflow scan". See board/r36s/uboot.fragment for the why.
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/uboot.fragment"

# --- Boot script -------------------------------------------------------------
# Compiles board/r36s/boot.cmd into images/boot.scr with the host mkimage
# (-C none -A arm64 -T script). Buildroot does NOT notice edits to boot.cmd:
# run `make -C output host-uboot-tools-dirclean` first.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/boot.cmd"

# --- Image assembly ----------------------------------------------------------
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/post-image.sh"
