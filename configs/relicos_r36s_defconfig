# RelicOS on the R36S: mainline boot chain, mainline kernel, BusyBox userspace.
# The artifact is sdcard.img with the boot chain (TPL + SPL + BL31 + U-Boot
# proper), a FAT partition holding the boot script, kernel Image and DTB, and an
# ext4 partition the kernel mounts as its root filesystem.

# --- Target: RK3326 is a quad-core Cortex-A35 (ARMv8-A, 64-bit) --------------
BR2_aarch64=y
BR2_cortex_a35=y

# --- Patches: applied from this tree after each package's source extract ----
# patches/<pkg>/*.patch, in lexical order. Buildroot does NOT notice new or
# edited patches on its own: run `make -C output <pkg>-dirclean` first.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RELICOS_PATH)/patches"

# --- Toolchain: built from source, glibc -------------------------------------
# glibc is what the ecosystem recipes around this hardware are tested against.
# Kernel headers pinned to 6.12 now so the toolchain does not have to be
# rebuilt when the kernel arrives in a later milestone.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_12=y
# C++ arrived with Mesa (M9): mesa3d depends on BR2_INSTALL_LIBSTDCPP, which
# only this symbol selects. Flipping it invalidates the whole toolchain --
# the M9 build was a full `rm -rf output` rebuild, deliberately.
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- Kernel: mainline 6.12 LTS ----------------------------------------------
# Same version as the pinned headers (BR2_KERNEL_HEADERS_6_12 == 6.12.91), so
# adding the kernel does not rebuild the toolchain.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.91"
# Upstream's own arm64 defconfig: the configuration mainline tests. It already
# carries ARCH_ROCKCHIP, dw_mmc-rockchip, 8250_dw and rk817. Trimming it is a
# later milestone, with measurements.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
# Raw Image: what booti takes directly, no decompressor in the middle.
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Our own DTS lives here. Buildroot rsyncs this directory into the kernel's
# arch/arm64/boot/dts/, keeping subdirectories -- which is why the file sits
# under dts/rockchip/: it must land next to rk3326-odroid-go.dtsi for the
# include to resolve. The .dtb is installed flat into output/images/.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/dts"
# Merged on top of the arch defconfig above. Buildroot does NOT reconfigure the
# kernel when this file changes: run `make -C output linux-dirclean` first.
# This is the first change in the project that alters the kernel Image, so the
# M4/M5 "Image is byte-identical" invariant ends here, deliberately, and the
# new hash becomes the baseline.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/linux.fragment"

# --- Root filesystem: one ext4 partition on the card -------------------------
# The kernel mounts it directly: there is no initramfs. See board/r36s/boot.cmd
# for how it is named on the kernel command line (PARTUUID, not a device node:
# this board has two SD slots and MBR partitions cannot carry labels).
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="relicos-root"
# Grown from 64M in M9: Mesa's Panfrost drags LLVM/clang/libclc into the
# target (see the GPU section below), the first real rootfs growth. The FAT
# stays at 160M so the rootfs offset on the card is still 176M; only the
# partition (and image) size changes. Real usage is measured and recorded in
# the M9 field note; trimming is a seed for a later milestone.
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"
# BR2_TARGET_ROOTFS_TAR is not set

# --- GPU userspace (M9): Mesa with the Gallium panfrost driver + kmscube -----
# The other half of ADR 0002 ("mainline + Panfrost"): the kernel driver is in
# board/r36s/linux.fragment; this is the userspace that speaks to it.
# Scope is the minimum that proves the thesis: GLES + EGL + GBM for a KMS/DRM
# render with no display server -- no GLX/X11, no Vulkan, no Wayland. GBM,
# libdrm, expat and zlib arrive via select.
BR2_PACKAGE_MESA3D=y
# Ballast, accepted deliberately (M9 decision): in this Buildroot the panfrost
# driver `depends on` target LLVM and `select`s the precomp shader compiler,
# which in turn selects OpenCL => clang + libclc on the target. The precomp
# compiler (mesa_clc) only ever runs on the build host; none of this is used
# at runtime on the device. Decoupling it is a trim-milestone seed, not a
# bring-up fight.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# The canonical "GPU first light" test: a spinning cube on KMS/GBM/EGL,
# GLES2, FPS on stdout. Takes DRM master, so the fb console leaves the
# screen while it runs -- expected, not a bug.
BR2_PACKAGE_KMSCUBE=y

# --- SDL2 over KMS/DRM (M10) -------------------------------------------------
# The library layer between the EmulationStation and the M9 stack. KMSDRM is
# the only video driver compiled in (no X11/Wayland/fbdev), so SDL cannot pick
# a wrong one. Its GBM/EGL/GLES providers are mesa3d since M9; libdrm comes
# via select. With eudev below, sdl2.mk configures --enable-libudev and SDL
# enumerates joysticks through udev's classification.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_KMSDRM=y

# --- /dev management: eudev (M10, device-measured decision) ------------------
# The M5 "devtmpfs only, no hotplug agent" property ends here, deliberately.
# The first M10 card measured why: SDL2's udev-less fallback classifier only
# marks a device as a joystick when it has ABS_X+ABS_Y axes, so this unit's
# gpio-keys (17 buttons, BTN_GAMEPAD/BTN_DPAD_* codes, zero axes) was
# invisible to SDL -- sdl2-diag printed "joysticks: 1" (only adc-joystick)
# and the ES never saw a button. udev's own input_id classifies button-only
# gamepads as joysticks ("Others have buttons only but no axes" -- their
# comment); eudev is the ecosystem path (Batocera/KNULLI run it on this same
# hardware class). Chosen over patching SDL's fallback (Tiago, 2026-08-31).
# The two default-on extras stay off: module loading (this card ships no
# /lib/modules -- see post-build.sh) and the hwdb (input_id needs no hwdb,
# and it would cost a host-eudev build plus a binary blob in the rootfs).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_PACKAGE_EUDEV_MODULE_LOADING is not set
# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set

# --- EmulationStation dependencies (M10) -------------------------------------
# alsa-lib flips sdl2's --enable-alsa on automatically (sdl2.mk) and satisfies
# the ES's find_package(ALSA REQUIRED). No sound card is configured yet: mixer
# errors in the ES log are expected, not fatal -- real audio is its own
# milestone.
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_RAPIDJSON=y
# vlc is the ES's hard video-preview dependency (find_package(VLC REQUIRED),
# no off switch). Buildroot's vlc selects nothing scary here (qt/xcb only
# activate if those packages exist -- they don't), but ffmpeg is NOT pulled
# in by it: avcodec/swscale must be explicit or vlc builds without any real
# codec. Accepted ballast (M10 decision, same shape as M9's LLVM); trimming
# is a seed.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_VLC=y

# --- The menu itself (M10): our first custom packages ------------------------
# batocera-emulationstation (KNULLI fork, pinned commit) built standalone,
# the carbon theme (640x480-friendly), freeimage (the one dependency
# Buildroot upstream lacks, transplanted from batocera.linux -- renamed from
# their "libfreeimage": that exact name is a Buildroot legacy tombstone that
# selects BR2_LEGACY and stops the build), and the SDL diagnostic rung.
# Recipes live in package/ of this external tree.
BR2_PACKAGE_SDL2_DIAG=y
BR2_PACKAGE_FREEIMAGE=y
BR2_PACKAGE_EMULATIONSTATION=y
BR2_PACKAGE_ES_THEME_CARBON=y

# --- Rootfs overlay (M10): the ES's runtime wiring ---------------------------
# First overlay of the project: es_systems.cfg (one dummy system -- the ES
# discards systems with zero games and errors out with none left), the
# pre-seeded es_input.cfg for the button-less analog-stick joystick, symlinks
# pointing $HOME/.emulationstation at the shared /usr/share/emulationstation
# payload, and the dummy "game" file itself. M11 adds the autostart wrapper
# (usr/bin/relicos-menu, launched from the inittab -- see post-build.sh) and
# usr/sbin/shutdown, mapping the ES's `shutdown -Ph/-r now` onto BusyBox
# poweroff/reboot.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/rootfs-overlay"

# --- First-boot entropy (M11): haveged ---------------------------------------
# On a freshly flashed card nothing has seeded the kernel's crng yet, and
# S10udevd blocks the whole rcS on getrandom() until `crng init done` -- M10
# measured 7.7 s of that on the first boot (after one clean shutdown the
# S01seedrng seed kills it). haveged feeds the crng from CPU timing jitter,
# userspace only, no kernel change. Buildroot installs its init script as S21,
# after udevd where it is useless for this; post-build.sh renames it to S09.
BR2_PACKAGE_HAVEGED=y

# --- Post-build: no kernel modules in this milestone -------------------------
# The arm64 defconfig builds ~1300 modules (71 MiB installed, 95% of the root
# filesystem) and this milestone loads none of them: every driver on the boot
# path is built in. See the script for the full reasoning.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/post-build.sh"

# --- Identity on the serial console ------------------------------------------
# The login banner is the cheap, observable proof that the root filesystem the
# kernel mounted is the one we built -- the same trick as the DTB's "model".
BR2_TARGET_GENERIC_HOSTNAME="relicos"
BR2_TARGET_GENERIC_ISSUE="RelicOS"

# --- TF-A: BL31, the EL3 secure-world firmware -------------------------------
# Mainline U-Boot does not boot on 64-bit Rockchip without BL31 (it provides
# PSCI: CPU power on/off, suspend). "px30" is the SoC family; RK3326 is a
# variant of it. No BL32/OP-TEE: we keep the full 1 GiB of RAM.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="px30"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
# px30 produces bl31.elf only; the default here is "*.bin", which makes the
# install-to-images step fail with "cannot stat ... *.bin".
BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES="bl31/bl31.elf"

# --- U-Boot mainline ---------------------------------------------------------
# odroid-go2 is the closest mainline board (same SoC, same board family).
# Its SARADC board-detect table does not know this device's value (166), so
# the expected outcome is the full chain talking and stopping at
# "Unable to detect device type: -19" — that is M1 success, not failure.
# binman packs TPL+SPL+BL31+proper into the single u-boot-rockchip.bin.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_LATEST_VERSION=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="odroid-go2"
BR2_TARGET_UBOOT_NEEDS_DTC=y
# U-Boot's host tools (mkimage FIT support) include openssl headers, and
# mkeficapsule (built by default) needs gnutls and util-linux's libuuid.
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_UTIL_LINUX=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31_ELF=y
BR2_TARGET_UBOOT_USE_BINMAN=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip.bin"
# Fragment merged over the defconfig: re-enable the legacy image format (so
# "source" accepts mkimage -T script) and set our own bootcmd instead of
# bootstd's "bootflow scan". See board/r36s/uboot.fragment for the why.
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/uboot.fragment"

# --- Boot script -------------------------------------------------------------
# Compiles board/r36s/boot.cmd into images/boot.scr with the host mkimage
# (-C none -A arm64 -T script). Buildroot does NOT notice edits to boot.cmd:
# run `make -C output host-uboot-tools-dirclean` first.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/boot.cmd"

# --- Image assembly ----------------------------------------------------------
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RELICOS_PATH)/board/r36s/post-image.sh"
