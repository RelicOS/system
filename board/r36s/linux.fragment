# Kernel config fragment merged on top of the upstream arm64 defconfig
# (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES). First fragment in this tree.
#
# Everything the display needs is built IN, not built as a module. The card
# carries no /lib/modules and runs no hotplug agent (M5's measured decision),
# so a driver that is =m is a driver that never runs -- measured, not assumed:
# see the disproved "wave of probes" in docs/field-notes/m5-first-userspace.md.
# Built-in also means the panel lights before userspace exists, which keeps a
# userspace failure from looking like a display failure.

# The DRM core and the Rockchip display driver. ROCKCHIP_VOP and
# ROCKCHIP_DW_MIPI_DSI are already =y inside the arm64 defconfig; they were
# dead code because the driver wrapping them was a module.
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
# The Synopsys DSI host the Rockchip glue drives.
CONFIG_DRM_DW_MIPI_DSI=y
# The D-PHY sits below the DSI host in its own node (phy@ff2e0000) with its own
# driver. Without it the DSI host probes and no light comes out.
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
# Kept from the milestone's take 1 (the gameforce,chi-panel route, which died
# in the DSI host). The panel that actually lit is driven by the generic-dsi
# driver (kernel patch 0001, obj-y -- no config symbol), so this option is
# currently unbound: the panel-5 glass IS an ST7703-family part, but its
# description now lives as data in the DTS. Trim candidate for a config-slim
# milestone; left in because this exact Image is what the device proved.
CONFIG_DRM_PANEL_SITRONIX_ST7703=y
# The backlight. vcc_bl (RK817 LDO_REG7) has been probing since M4; what was
# missing was the PWM consumer on top of it.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# The analog sticks (M8), on mainline drivers only -- no out-of-tree joypad
# driver, no kernel API patches. Same house rule as the display block: =y,
# because =m on this card means "never runs".
#
# The SARADC itself. Was =m (i.e. never loaded): until M8 the kernel-side
# SARADC has never run on this unit -- U-Boot board detect uses its own
# driver. First milestone that turns it on under Linux.
CONFIG_ROCKCHIP_SARADC=y
# The mux stack that lets mainline adc-joystick read four axes off one
# SARADC input: gpio-mux drives the two select lines (gpio3 PB3/PB0)...
CONFIG_MUX_GPIO=y
# ...and io-channel-mux presents SARADC channel 1 as four virtual IIO
# channels, one per axis. (Their common core, CONFIG_MULTIPLEXER, is
# already =y in the arm64 defconfig.)
CONFIG_IIO_MUX=y
# The joystick input class (was unset) and the adc-joystick driver itself,
# polled at the DT's poll-interval; it selects IIO_BUFFER/IIO_BUFFER_CB
# on its own.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y

# The GPU (M9): Panfrost, the mainline driver for the Mali-G31 (Bifrost).
# Same house rule: =y, because =m on a card without /lib/modules never runs
# -- until M9 the GPU has never run under Linux on this unit. The DT node
# (gpu@ff400000) has been "okay" in our DTB since the start, inherited from
# rk3326-odroid-go.dtsi with mali-supply and the OPP table wired; the driver
# was the only missing piece, so the DTB must not change in this milestone.
# Panfrost selects its own helpers (DRM_SCHED, DRM_GEM_SHMEM_HELPER,
# IOMMU_IO_PGTABLE_LPAE); PM_DEVFREQ and DEVFREQ_GOV_SIMPLE_ONDEMAND are
# already =y in the arm64 defconfig.
CONFIG_DRM_PANFROST=y
