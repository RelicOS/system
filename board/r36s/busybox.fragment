# BusyBox config fragment merged on top of Buildroot's busybox.config
# (BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES).

# fbsplash paints a P6 PPM straight onto /dev/fb0 (M15, boot splash frame 2:
# the RelicOS logo, drawn by S15splash between the kernel's own logo and the
# menu). The only image-to-framebuffer tool the rootfs needs, and it is
# already in the box -- no extra package, no libpng.
CONFIG_FBSPLASH=y

# The menus (M22 part 3): the ES's INTERNET STATUS runs `timeout 1 ping`,
# and relicos-bluetooth ends a bluetoothctl scan with pkill.
CONFIG_TIMEOUT=y
CONFIG_PKILL=y

# The ports (M26 build 3, measured): pugwash asks `pgrep -f love.aarch64`
# before it opens a window and dies on "No such file or directory: 'pgrep'"
# (build 2b); pkill was here since M22, pgrep is the same applet family.
# Seamless xz: PortMaster's funcs.txt runs `tar -xf NotoSans.tar.xz` on
# every launch of every port, and this tar answered "invalid tar magic"
# each time (pugwash unpacks the fonts itself in Python, so nothing broke;
# the line is noise in every log until the tar can read xz).
CONFIG_PGREP=y
CONFIG_FEATURE_SEAMLESS_XZ=y
