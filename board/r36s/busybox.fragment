# BusyBox config fragment merged on top of Buildroot's busybox.config
# (BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES).

# fbsplash paints a P6 PPM straight onto /dev/fb0 (M15, boot splash frame 2:
# the RelicOS logo, drawn by S15splash between the kernel's own logo and the
# menu). The only image-to-framebuffer tool the rootfs needs, and it is
# already in the box -- no extra package, no libpng.
CONFIG_FBSPLASH=y

# The menus (M22 part 3): the ES's INTERNET STATUS runs `timeout 1 ping`,
# and relicos-bluetooth ends a bluetoothctl scan with pkill.
CONFIG_TIMEOUT=y
CONFIG_PKILL=y
