#!/bin/sh
# RelicOS storage (M12, M19): mount the two writable partitions of the card
# we booted from, seed /data the first time, and -- the first time only --
# grow the user partition RELICOS to the end of the card.
#
# Runs FIRST in rcS -- before S01seedrng, whose seed now lives on /data.
# It needs no udev: /dev is devtmpfs and /sys was mounted by the inittab's
# `mount -a`, both before rcS starts.
#
# Partitions are found through sysfs, starting from the device the kernel
# mounted as root: never a fixed node (this board has two SD slots and
# U-Boot's numbering is not the kernel's) and never a label (a second
# RelicOS card would answer to it). Whichever slot we booted, the data is
# on the same card. BusyBox mount could not do this by name anyway: its
# LABEL=/UUID= resolution is compiled out, and /dev/disk/by-partuuid/
# symlinks only exist after udevd -- which runs later and needs no delay
# here.

DATA=/data
RELICOS=/relicos
SKEL=/usr/share/relicos/data

# The ES only honors an emulationstation.ini key whose value is a
# directory that already exists, so these are created before the menu.
RELICOS_DIRS="roms bios themes music saves screenshots overlays update"

# One ROM folder per system in es_systems.cfg (M20). The image already
# ships them with a README inside, so this list matters for a card
# written BEFORE M20: an update brings the new systems, and without the
# folders the user has nowhere to put their games. The two lists (this
# one and es_systems.cfg) are kept in step by hand -- a folder with no
# system is an empty directory, a system with no folder is a menu entry
# the user cannot fill. ports (M26) is not a console: it is where
# PortMaster's installer is copied, where PortMaster then lives, and where
# every port it installs lands, with its autoinstall/ folder.
RELICOS_ROMS="atari2600 gamegear gb gba mastersystem megadrive nes ngp ports \
	pcengine sega32x sg1000 snes vectrex virtualboy wswan"

# GPT keeps a backup copy of its table in the last 33 sectors of the disk,
# so the last usable sector is the disk's length minus 34.
GPT_TAIL=34
# Free tail (512-byte sectors, 8 MiB) below which nothing is grown: a card
# the image only just fits, or the rounding an earlier grow left behind.
GROW_MIN=16384
# Set when a grow needed a reboot for the kernel to see the new size, so
# that it is asked for once and never in a loop.
GROW_REBOOT="$DATA/.relicos-grow-reboot"

# Echo the sysfs directory of the disk holding the root fs.
root_disk() {
	mm=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
	[ -n "$mm" ] || return 1
	dirname "$(readlink -f "/sys/dev/block/$mm")"
}

# Echo the sysfs directory of partition $1 of the disk holding the root fs.
part_sysfs() {
	disk=$(root_disk) || return 1
	for p in "$disk"/*; do
		[ "$(cat "$p/partition" 2>/dev/null)" = "$1" ] || continue
		echo "$p"
		return 0
	done
	return 1
}

# Echo the device node of partition $1 of the disk holding the root fs.
part_of_root() {
	p=$(part_sysfs "$1") || return 1
	echo "/dev/$(basename "$p")"
}

# The slots by name (M25): /dev/relicos/{boot,root}_{a,b} -> partitions 1-4
# of the disk we booted from, for whoever must address a slot -- the
# updater (RAUC's system.conf, step 2) and the bench. Symlinks in devtmpfs
# (writable), not udev rules or /dev/disk/by-partuuid: a second RelicOS
# card in the other SD slot has the SAME PARTUUIDs (they are pinned), so
# only "the disk under the root" tells the two apart -- the rule the
# mounts below already follow.
#
# /run/fw_env.config says where the U-Boot environment lives on that disk,
# for fw_printenv/fw_setenv (libubootenv): two 32 KiB copies at 12 MiB and
# 12 MiB + 32 KiB -- the numbers of board/r36s/uboot.fragment, which is the
# one place they are decided. /etc/fw_env.config is a symlink to it because
# /etc is on the erofs and the disk name is not known until boot.
name_slots() {
	disk=$(root_disk) || return 1
	dev="/dev/$(basename "$disk")"
	mkdir -p /dev/relicos
	for pair in boot_a:1 boot_b:2 root_a:3 root_b:4; do
		p=$(part_of_root "${pair#*:}") || continue
		ln -sfn "$p" "/dev/relicos/${pair%%:*}"
	done
	printf '%s 0xC00000 0x8000\n%s 0xC08000 0x8000\n' "$dev" "$dev" > /run/fw_env.config
	echo "$dev"
}

# Copy what the skeleton has and /data lacks. NEVER overwrite: what is
# already there belongs to the user, and honoring that is the whole
# contract an update has with their data.
seed_data() {
	( cd "$SKEL" && find . ! -name . ) | while read -r rel; do
		src="$SKEL/${rel#./}"
		dst="$DATA/${rel#./}"
		if [ -e "$dst" ] || [ -L "$dst" ]; then continue; fi
		if [ -d "$src" ] && [ ! -L "$src" ]; then
			mkdir -p "$dst"
		else
			cp -a "$src" "$dst"
		fi
	done
	mkdir -p "$DATA/seedrng"
	# RAUC's statusfile lives here (/etc/rauc/system.conf); RAUC creates
	# the file, not the directory.
	mkdir -p "$DATA/rauc"
	# What an update owes /data (M25): es_systems.cfg is the product's and
	# moved to the rootfs (/usr/bin, next to the ES), where a bundle
	# replaces it. Images from M12 to M25 seeded a copy here, and the ES
	# reads that one first if it exists -- so the seeded copy is set aside
	# once, under a name the ES does not look for. The user's own override
	# is es_systems_custom.cfg, which nothing here touches.
	old="$DATA/system/.emulationstation/es_systems.cfg"
	if [ -f "$old" ]; then
		mv -f "$old" "$old.pre-m25" && echo "Seed: es_systems.cfg set aside (the rootfs copy is the menu now)"
	fi
}

# Grow partition 6 -- RELICOS, the last one -- to the end of the card (M19).
#
# The image is built for a 3344 MiB card; on a bigger one everything past
# the map is dead space, and the kernel says so on every boot ("GPT:
# Alternate GPT header not at the end of the disk"). The decision comes
# from the sysfs numbers alone, no marker file: a card already grown reads
# as "nothing to do" on every boot. Three tools, in this order:
#   parted --fix   answers "Fix" to the GPT's "not all of the space is
#                  used", which moves the backup table to the end of the
#                  card; naming the partition is the command that writes.
#   fatresize      grows the FAT32 and the partition together (grown
#                  partition first and it aborts -- rehearsed). It resizes
#                  the filesystem first and commits the table after; the
#                  kernel learns the new size by BLKPG, because a full
#                  re-read fails while the rootfs partition is mounted.
#   fatlabel       libparted's resizer writes the boot sector without a
#                  label ("NO NAME", rehearsed), and Windows reads the
#                  boot sector.
# Runs before RELICOS is mounted: fatresize refuses a busy partition.
# Whatever fails leaves the partition as it was (1 GiB, working), the
# console line says which step, and the next boot tries again.
grow_relicos() {
	p=$(part_sysfs 6) || return 0
	disk=$(dirname "$p")
	dev="/dev/$(basename "$disk")"
	pdev="/dev/$(basename "$p")"
	total=$(cat "$disk/size")
	start=$(cat "$p/start")
	size=$(cat "$p/size")
	want=$(( total - GPT_TAIL - start + 1 ))
	if [ $(( want - size )) -lt "$GROW_MIN" ]; then
		rm -f "$GROW_REBOOT"
		return 0
	fi

	echo "RELICOS: growing partition 6 to the card ($(( size / 2048 )) MiB -> $(awk "BEGIN { printf \"%.1f\", $want / 2097152 }") GiB)"
	parted --script --fix "$dev" name 6 relicos ||
		{ echo "RELICOS: FAIL (parted could not fix the GPT)"; return 1; }
	fatresize -f -n 6 -s $(( want * 512 )) "$dev" ||
		{ echo "RELICOS: FAIL (fatresize)"; return 1; }
	fatlabel "$pdev" RELICOS ||
		echo "RELICOS: fatlabel failed, the label may read NO NAME"

	# The kernel should have taken the new size through BLKPG. If it
	# did not, table and filesystem are already grown and one reboot
	# (through the PMIC since M18) makes it read the table fresh. Once:
	# the marker on /data is what keeps this from looping.
	if [ "$(cat "$p/size")" = "$size" ]; then
		if [ -e "$GROW_REBOOT" ]; then
			echo "RELICOS: FAIL (kernel kept the old size, even after a reboot)"
			return 1
		fi
		echo "RELICOS: kernel kept the old size, rebooting once"
		touch "$GROW_REBOOT"
		sync
		reboot
		return 1
	fi
	rm -f "$GROW_REBOOT"
	echo "RELICOS: OK ($(( $(cat "$p/size") / 2048 )) MiB)"
}

start() {
	printf 'Naming slots: '
	if dev=$(name_slots); then echo "OK (/dev/relicos -> $dev)"; else echo "FAIL (no root disk)"; fi

	printf 'Mounting data: '
	dev=$(part_of_root 5) || { echo "FAIL (no partition 5)"; return 1; }
	mount -t ext4 -o noatime "$dev" "$DATA" || { echo "FAIL ($dev)"; return 1; }
	seed_data
	echo "OK ($dev)"

	grow_relicos

	printf 'Mounting relicos: '
	dev=$(part_of_root 6) || { echo "FAIL (no partition 6)"; return 1; }
	# The second mount, without utf8=1, is the fallback in case the
	# kernel refuses the option -- the datum is the message on the
	# serial console, not a guess.
	mount -t vfat -o noatime,umask=0000,utf8=1 "$dev" "$RELICOS" ||
		mount -t vfat -o noatime,umask=0000 "$dev" "$RELICOS" ||
		{ echo "FAIL ($dev)"; return 1; }
	for d in $RELICOS_DIRS; do mkdir -p "$RELICOS/$d"; done
	for d in $RELICOS_ROMS; do mkdir -p "$RELICOS/roms/$d"; done
	echo "OK ($dev)"
}

stop() {
	printf 'Unmounting storage: '
	sync
	umount "$RELICOS" 2>/dev/null
	umount "$DATA" 2>/dev/null
	echo OK
}

case "$1" in
	start|stop)	"$1" ;;
	restart|reload)	stop; start ;;
	*)		echo "Usage: $0 {start|stop|restart}"; exit 1
esac
