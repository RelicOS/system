#!/bin/sh
# RelicOS menu autostart. Launched by BusyBox init (::once: in
# /etc/inittab, appended by post-build.sh), which runs "once" entries
# only after every sysinit entry -- the whole rcS, S10udevd's settle
# included -- so the input devices are already enumerated here.
#
# init passes no login environment: set what the ES needs explicitly.
# HOME is where the ES writes everything it writes (M10 measured it);
# since M12 that is the journaled data partition, never the rootfs --
# which has no write path to give.
export HOME=/data/system
export SDL_VIDEODRIVER=kmsdrm

# Bench switch: the file's presence skips the kiosk loop entirely. It
# lives on RELIC now, so it can be created from the serial shell OR from
# any PC that mounts the card:
#   touch /relic/relicos-bench; killall emulationstation
BENCH=/relic/relicos-bench

# Bench hook. The rootfs is erofs now: there is no `mount -o remount,rw /`
# to edit this file in place, which is how M11's --debug A/B was run. The
# replacement is explicit -- drop a script here, from the serial shell or
# from any PC that mounts RELIC, and it runs instead of the default line.
HOOK=/relic/relicos-menu

# No storage, no ES: it would have nowhere to write and no ROM to list.
# The serial shell owns the machine instead -- same spirit as the bench
# switch, and the reason it is checked before anything else.
mountpoint -q /data  || { echo "relicos-menu: no /data, bench mode";  exit 0; }
mountpoint -q /relic || { echo "relicos-menu: no /relic, bench mode"; exit 0; }

[ -e "$BENCH" ] && exit 0

while :; do
	rm -f /tmp/restart.please /tmp/reboot.please /tmp/shutdown.please
	# No --debug: with it, the ES pushes ~100 KB of log through the
	# 115200-baud console during startup -- a measured ~8 s of the boot
	# (M11 A/B: power-to-menu ~20 s with it, ~12 s without). es_log.txt
	# still carries INFO/ERROR; relaunch with --debug from the bench
	# shell when chasing something. The splash stays on (no --no-splash,
	# unlike the M10 bench line): a loading screen beats a black gap
	# while the theme loads (Tiago, 2026-09-01).
	#
	# Absolute path, not the PATH lookup of M11: the ES derives its own
	# directory from argv[0], and that is where it looks for
	# emulationstation.ini. Launched as bare "emulationstation" the
	# lookup silently misses and the whole path map is ignored.
	if [ -f "$HOOK" ]; then "$HOOK"; else /usr/bin/emulationstation; fi
	# The ES always exits 0; intent lives in marker files it touches
	# right before running the power command (es-core Platform.cpp).
	[ -e /tmp/shutdown.please ] && exit 0   # poweroff is in flight
	[ -e /tmp/reboot.please ] && exit 0     # reboot is in flight
	[ -e "$BENCH" ] && exit 0               # bench asked for the shell
	# restart.please (the ES asked to be restarted) or a crash: relaunch.
	# The sleep keeps a crash-at-startup from becoming a tight loop; the
	# bench file is the emergency brake.
	sleep 2
done
