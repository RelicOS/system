/*
 * RelicOS base device tree for the R36S.
 *
 * This is the mainline ODROID-GO Advance description under a name of our own,
 * with exactly three hardware differences described so far: the panel, the
 * button wiring and the muxed analog sticks (all below). The R36S is close
 * enough to an OGA to bring a kernel up on the serial console; the real
 * differences were each added one change at a time, with the device
 * watching (M6, M7, M8).
 *
 *   - model is what the kernel prints as "Machine model:", so the serial log
 *     proves which DTB was loaded;
 *   - the OGA compatible string is kept in the list, because that is honestly
 *     what this file still mostly describes.
 */

/dts-v1/;
#include "rk3326-odroid-go2.dts"

/ {
	model = "RelicOS R36S (ODROID-GO Advance description)";
	compatible = "relicos,r36s", "hardkernel,rk3326-odroid-go2",
		     "rockchip,rk3326";
};

/*
 * The panel: this unit's actual glass, an R36S "panel 5" (ST7703-family
 * controller, 640x480, 4 lanes), described as data for the generic DSI
 * panel driver (rocknix,generic-dsi, kernel patch 0001) -- timings, flags
 * and the full DCS init sequence live in panel_description; the init runs
 * from .prepare, in command mode, before video starts.
 *
 * How this file got here (M6, one observation per change):
 *  - phase A carried the ArkOS Panel 4 description on this same driver --
 *    device-proven 2026-08-31: init crossed the link with zero errors,
 *    vblanks flowed, backlight lit, and the image was garbled exactly as
 *    predicted for panel-4 data on panel-5 glass. Pipeline validated.
 *  - phase B (this file) swaps only the data: the panel-5 description
 *    generated by attempt 1 from this unit's vendor DTB (AeolusUX
 *    "Panel 5", importpanel.py). SETMIPI here says 0x33 = 4 lanes -- the
 *    2-lane 0x31 of the chi-panel route is what died in take 1.
 *
 * Two mechanical deviations from the generated overlay, both deliberate:
 *  - the leading name='R36S Panel 5' token is stripped: this driver
 *    revision aborts G-line parsing at any unknown parameter, and name=
 *    comes first -- keeping it would silently discard lanes/flags/delays;
 *  - the generator's "# failed to find mode for fps=60" comment line is
 *    dropped as inert noise.
 * Everything else -- flags=0xe03, the vendor delays, all 11 modes with the
 * vendor's 40760 kHz default, every init byte -- is verbatim from the
 * generated overlay: the reference for this unit's glass is its own vendor
 * DTB.
 *
 * Property mechanics: vdd-supply and iovcc-supply are inherited from the
 * OGA base node (both vcc_lcd) and generic-dsi asks for exactly those
 * names; rotation is deleted because this is landscape glass mounted the
 * right way up; reset-gpios (gpio3 PC0) and backlight are inherited
 * unchanged -- measured identical across OGA and every R36S tree compared.
 */
&internal_display {
	compatible = "rocknix,generic-dsi";
	/delete-property/ rotation;
	panel_description =
		"G size=71,71 delays=100,50,20,200,20 format=rgb888 lanes=4 flags=0xe03",

		"M clock=40760 horizontal=640,120,139,120 vertical=480,17,5,13 default=1",
		"M clock=27650 horizontal=640,188,9,190 vertical=480,13,41,5",
		"M clock=25500 horizontal=640,188,2,190 vertical=480,13,2,5",
		"M clock=23930 horizontal=640,87,39,87 vertical=480,13,63,5",
		"M clock=23460 horizontal=640,87,2,87 vertical=480,13,2,5",
		"M clock=26600 horizontal=640,87,20,87 vertical=480,13,36,5",
		"M clock=24840 horizontal=640,87,5,87 vertical=480,13,8,5",
		"M clock=30620 horizontal=640,87,38,87 vertical=480,13,100,5",
		"M clock=43580 horizontal=640,120,168,120 vertical=480,17,41,13",
		"M clock=46350 horizontal=640,120,120,120 vertical=480,17,5,13",
		"M clock=61800 horizontal=640,120,120,120 vertical=480,17,5,13",

		"I seq=b9f11283",
		"I seq=ba338105f90e0e2000000000000000442500910a0000024fd1000037",
		"I seq=b825",
		"I seq=bf021100",
		"I seq=b30c100a5003ff00000000",
		"I seq=c0737350500000087000",
		"I seq=bc46",
		"I seq=cc0b",
		"I seq=b480",
		"I seq=b20013f0",
		"I seq=e307070b0b030b00000000ff00c010",
		"I seq=c153001e1e77e1ccdd67773333",
		"I seq=b51010",
		"I seq=b66c7c",
		"I seq=e908000e0000b0b11131232810b0b127080004020000000004020000008888ba60240888888888888888ba713518888888888800000001000000000000000000",
		"I seq=ea970a820213070000000000008088ba17538888888888888188ba0642888888888888231000028000000000000000000000000000000000000000000000",
		"I seq=e000070b272d3f3b37050a0b0f110f12121800070b272d3f3b37050a0b0f110f121218",
		"I seq=11 wait=150",
		"I seq=29 wait=50";
};

/*
 * The buttons: the R36S wiring, transplanted as data into the mainline
 * gpio-keys driver that has been probing since M4 (M7, one change: this
 * DTS only -- kernel, fragment and boot script untouched).
 *
 * The GPIO->function map comes from two independent lineages that agree
 * entry for entry -- the Arch-R DTS (odroidgo3-joypad node, sw1-sw22) and
 * ROCKNIX (rocknix-r36s.dts / r3xs.dtsi) -- and was device-validated on
 * this unit 2026-08-31 (M7 recon, all 20 table cells confirmed): 10
 * buttons already correct under the inherited OGA map, 5 firing with OGA
 * function-key codes, 4 silent because their gpio3 lines had no
 * description (and float without the pull-ups added below).
 *
 * Layout notes:
 *  - the OGA button-sw* nodes are deleted wholesale and the 17 gamepad
 *    buttons re-described from the R36S table, so this node reads as what
 *    it is: the R36S map, not an OGA diff. Y/X keep the OGA codes on
 *    purpose -- PA6 = Y = BTN_WEST, PA7 = X = BTN_NORTH was confirmed on
 *    this unit (recon pressed X first; the codes matched the wiring).
 *  - volume lives in its own gpio-keys node because autorepeat is a
 *    per-device property: VOLUMEUP/DOWN are keyboard-style keys that
 *    should repeat while held, gamepad buttons must not (games read
 *    held state; menu repeat is the frontend's job). Same split as
 *    Arch-R; ROCKNIX ships no autorepeat at all.
 *  - the analog sticks live in their own section below (M8): mainline
 *    adc-joystick behind an IIO mux -- no buttons in it, the 19 above
 *    stay exactly where M7 proved them.
 */
&builtin_gamepad {
	/delete-node/ button-sw1;
	/delete-node/ button-sw2;
	/delete-node/ button-sw3;
	/delete-node/ button-sw4;
	/delete-node/ button-sw5;
	/delete-node/ button-sw6;
	/delete-node/ button-sw7;
	/delete-node/ button-sw8;
	/delete-node/ button-sw9;
	/delete-node/ button-sw10;
	/delete-node/ button-sw11;
	/delete-node/ button-sw12;
	/delete-node/ button-sw13;
	/delete-node/ button-sw14;
	/delete-node/ button-sw15;
	/delete-node/ button-sw16;

	button-dpad-up {
		gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_LOW>;
		label = "DPAD-UP";
		linux,code = <BTN_DPAD_UP>;
	};
	button-dpad-down {
		gpios = <&gpio1 RK_PB5 GPIO_ACTIVE_LOW>;
		label = "DPAD-DOWN";
		linux,code = <BTN_DPAD_DOWN>;
	};
	button-dpad-left {
		gpios = <&gpio1 RK_PB6 GPIO_ACTIVE_LOW>;
		label = "DPAD-LEFT";
		linux,code = <BTN_DPAD_LEFT>;
	};
	button-dpad-right {
		gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_LOW>;
		label = "DPAD-RIGHT";
		linux,code = <BTN_DPAD_RIGHT>;
	};
	button-a {
		gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		label = "BTN-A";
		linux,code = <BTN_EAST>;
	};
	button-b {
		gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_LOW>;
		label = "BTN-B";
		linux,code = <BTN_SOUTH>;
	};
	button-y {
		gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_LOW>;
		label = "BTN-Y";
		linux,code = <BTN_WEST>;
	};
	button-x {
		gpios = <&gpio1 RK_PA7 GPIO_ACTIVE_LOW>;
		label = "BTN-X";
		linux,code = <BTN_NORTH>;
	};
	button-thumbl {
		gpios = <&gpio2 RK_PA2 GPIO_ACTIVE_LOW>;
		label = "BTN-THUMBL";
		linux,code = <BTN_THUMBL>;
	};
	button-thumbr {
		gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_LOW>;
		label = "BTN-THUMBR";
		linux,code = <BTN_THUMBR>;
	};
	button-fn {
		gpios = <&gpio2 RK_PA4 GPIO_ACTIVE_LOW>;
		label = "BTN-FN";
		linux,code = <BTN_MODE>;
	};
	button-l1 {
		gpios = <&gpio2 RK_PA6 GPIO_ACTIVE_LOW>;
		label = "BTN-L1";
		linux,code = <BTN_TL>;
	};
	button-r1 {
		gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_LOW>;
		label = "BTN-R1";
		linux,code = <BTN_TR>;
	};
	button-select {
		gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
		label = "BTN-SELECT";
		linux,code = <BTN_SELECT>;
	};
	button-l2 {
		gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		label = "BTN-L2";
		linux,code = <BTN_TL2>;
	};
	button-start {
		gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
		label = "BTN-START";
		linux,code = <BTN_START>;
	};
	button-r2 {
		gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		label = "BTN-R2";
		linux,code = <BTN_TR2>;
	};
};

/ {
	gpio_keys_vol: gpio-keys-vol {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins_vol>;

		button-vol-up {
			gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "VOLUME-UP";
			linux,code = <KEY_VOLUMEUP>;
		};
		button-vol-down {
			gpios = <&gpio2 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "VOLUME-DOWN";
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};
};

/*
 * Button pull-ups. Overriding rockchip,pins replaces the OGA list whole,
 * so this is the full R36S set: the inherited gpio1/gpio2 pins minus the
 * ghost (gpio2 PA5 -- OGA F6, no button on this board) and minus PA0/PA1
 * (volume, moved to btn_pins_vol with its own node above), plus the four
 * gpio3 lines no distro DTB describes together with this panel. Without
 * a pull-up an undescribed line floats and "presses itself".
 */
&btn_pins {
	rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
			<1 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
			<2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
			<3 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>,
			<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
			<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
			<3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;
};

&pinctrl {
	btns {
		btn_pins_vol: btn-pins-vol {
			rockchip,pins = <2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	joystick {
		/* The mux enable line, held asserted (the pin is active-low)
		 * by pinctrl at boot: the analog mux is simply always on.
		 * No conflict with btn_pins: buttons use gpio3 PB1/PB2/PB4/
		 * PB7, the mux uses PB0/PB3/PB5. */
		mux_en_pins: mux-en-pins {
			rockchip,pins = <3 RK_PB5 RK_FUNC_GPIO &pcfg_output_low>;
		};
	};
};

/*
 * The analog sticks: four axes (two sticks x X/Y) multiplexed onto a single
 * SARADC input (channel 1) through GPIO select lines -- described for
 * mainline drivers only (M8): gpio-mux drives the select lines,
 * io-channel-mux presents SARADC channel 1 as four virtual IIO channels,
 * and adc-joystick (the node inherited from the OGA base, rewired below)
 * consumes one channel per axis. No out-of-tree joypad driver, no kernel
 * API patches.
 *
 * The wiring comes from the same two lineages that agreed on the buttons
 * (M7): select A/B = gpio3 PB3/PB0, enable = PB5, all active-low, SARADC
 * channel 1 -- identical between Arch-R's amux-*-gpios and nixos-r36s's
 * mux-gpios/mux_en_pins. The channel->axis map and the two inversions also
 * agree once the GPIO polarity conventions are unwound (Arch-R's legacy
 * gpio API sets raw levels, gpio-mux sets logical ones, and every select
 * line is active-low): mux state 0/1/2/3 = ABS_X/ABS_RX/ABS_Y/ABS_RY,
 * left stick inverted on both axes. Arch-R spells the inversion
 * "invert-absx/invert-absy, required for RG36S"; here it is abs-range
 * with min > max, which mainline adc-joystick honors natively.
 *
 * The abs-range numbers are nixos-r36s's, measured on *their* unit: the
 * starting point, expected to need per-unit recalibration against raw
 * sysfs reads of the mux channels (the M8 observation ladder).
 * poll-interval = <60> ms is inherited from the OGA node.
 */
/ {
	joystick_mux_controller: mux-controller {
		compatible = "gpio-mux";
		pinctrl-names = "default";
		pinctrl-0 = <&mux_en_pins>;
		#mux-control-cells = <0>;

		mux-gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>,
			    <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
	};

	joystick_mux: adc-mux {
		compatible = "io-channel-mux";
		io-channels = <&saradc 1>;
		io-channel-names = "parent";
		#io-channel-cells = <1>;

		mux-controls = <&joystick_mux_controller>;
		channels = "0", "1", "2", "3";
	};
};

/*
 * The OGA node described two axes on two direct SARADC channels (1 and 2)
 * -- wiring this board does not have (and which never probed here anyway:
 * CONFIG_INPUT_JOYSTICK was unset until M8). Rewired to the four mux
 * channels; the two OGA axes are deleted and all four described fresh, so
 * the node reads as the R36S map, not an OGA diff (M7 precedent).
 */
/*
 * Axis order is deliberate, and it is a workaround -- device-measured on
 * this unit, 2026-08-31 (m8-analog log): mainline adc-joystick (through
 * 6.12 and still on master today) calls adc_joystick_invert(input, i, val)
 * with the *channel index* where the function expects an *ABS code* (it
 * looks the axis limits up by code). An inverted axis whose code differs
 * from its index therefore inverts against the wrong axis's limits --
 * here ABS_Y at index 2 read ABS_Z's unset 0/0 limits and reported -raw.
 * The fix is data: keep every *inverted* axis at index == its ABS code
 * (X at 0, Y at 1), which makes buggy and fixed kernels compute the same
 * thing. The physical mux channel each axis reads is preserved by
 * reordering io-channels instead (Y's glass wire is mux channel 2).
 * Uninverted axes never call the invert path, so their slots are free.
 */
&analog_sticks {
	io-channels = <&joystick_mux 0>,
		      <&joystick_mux 2>,
		      <&joystick_mux 1>,
		      <&joystick_mux 3>;

	/delete-node/ axis@0;
	/delete-node/ axis@1;

	axis@0 {
		reg = <0>;
		abs-flat = <10>;
		abs-fuzz = <10>;
		abs-range = <900 30>;
		linux,code = <ABS_X>;
	};

	axis@1 {
		reg = <1>;
		abs-flat = <10>;
		abs-fuzz = <10>;
		abs-range = <880 80>;
		linux,code = <ABS_Y>;
	};

	axis@2 {
		reg = <2>;
		abs-flat = <10>;
		abs-fuzz = <10>;
		abs-range = <80 960>;
		linux,code = <ABS_RX>;
	};

	axis@3 {
		reg = <3>;
		abs-flat = <10>;
		abs-fuzz = <10>;
		abs-range = <60 850>;
		linux,code = <ABS_RY>;
	};
};

/*
 * The sound (M13). The OGA base describes an ODROID-GO Advance speaker:
 * the rk817's class-D output (SPKO) driving the cone, selected with the
 * codec's hardware-exclusive "Playback Mux" (SPK = class-D on the shared
 * SPKO/HPOL pin, HP = the headphone DACs). The R36S is not wired that way.
 * Every lineage that has the board agrees (docs/research/r36s-audio-wiring.md):
 * the speaker is an EXTERNAL amplifier fed from the headphone line
 * HPOL/HPOR, and the class-D is never used -- ROCKNIX's R36S quirk selects
 * mux HP for speakers, its clone template and mainline's
 * rk3326-gameforce-chi.dts describe an amplifier on HPOL/HPOR, Arch-R ships
 * that card for "R36S original and most clone batches". With the mux at
 * SPK this unit produced distortion (m13-som-2253); with it at HP and the
 * I2S clock fixed (kernel patch 0002) it plays clean (m13-som-1115).
 *
 * So the card is a plain simple-audio-card with both outputs on the
 * headphone DACs. What the ecosystem templates add on top was measured on
 * this unit and does NOT apply here:
 *
 *  - gpio3 PA7 is the amplifier ENABLE on V20 clones (vendor DTB
 *    `spk-ctl-gpios`, active high). Here it gates nothing: the speaker
 *    plays with PA7 low and high alike (m13-som-1239). What PA7 does do is
 *    corrupt the speaker path when driven HIGH with a plug in the jack
 *    (m13-som-1321: distorted hiss from the speaker next to clean
 *    headphones), while LOW never costs anything (four states measured).
 *    Hence the gpio-hog below and no simple-audio-amplifier.
 *  - gpio2 C6 is the jack DETECT on the OGA and the clone templates. Here
 *    it reads high with no pull, with a pull-up and against a pull-down,
 *    plug in or out (m13-som-2356, -1126, -1148): driven high from
 *    outside, never an event. The jack switches speaker/headphones
 *    MECHANICALLY (plug in: headphones only; out: speaker only). So no
 *    hp-det: under ACTIVE_HIGH a stuck-high detect would report
 *    "headphones" forever.
 *
 * The card keeps the ecosystem name rk817_ext ("external amplifier on the
 * headphone line" is true here too); the ID in /proc/asound/cards is
 * rk817ext. No microphone: the R36S has none.
 */
/ {
	/delete-node/ rk817-sound;

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rk817_ext";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Headphone", "Headphones",
			"Speaker", "Internal Speakers";
		simple-audio-card,routing =
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Internal Speakers", "HPOL",
			"Internal Speakers", "HPOR";

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};

		simple-audio-card,cpu {
			sound-dai = <&i2s1_2ch>;
		};
	};
};

&gpio3 {
	/* PA7 high with a plug in the jack corrupts the speaker path; low
	 * never costs anything (see "The sound"). Held low from boot. */
	spk_ctl_hog: spk-ctl-hog {
		gpio-hog;
		gpios = <RK_PA7 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "spk-ctl (held low, see rk3326-r36s.dts)";
	};
};
